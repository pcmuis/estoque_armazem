rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn() && exists(adminPath()) && get(adminPath()).data.active == true;
    }

    function employeeAuthPath() {
      return /databases/$(database)/documents/employeeAuth/$(request.auth.uid);
    }

    function employeeId() {
      return get(employeeAuthPath()).data.employeeId;
    }

    function employeePath() {
      return /databases/$(database)/documents/employees/$(employeeId());
    }

    function isEmployee() {
      return signedIn()
        && request.auth.token.email.matches('.*@staff\\.estoquearmazem\\.invalid$')
        && exists(employeeAuthPath())
        && get(employeeAuthPath()).data.active == true
        && exists(employeePath())
        && get(employeePath()).data.active == true
        && get(employeePath()).data.authUid == request.auth.uid
        && get(employeePath()).data.loginEmail == request.auth.token.email;
    }

    function employeeCanMove(movementType) {
      return isEmployee()
        && ((movementType == 'entry' && get(employeePath()).data.canAdd == true)
          || (movementType == 'withdrawal' && get(employeePath()).data.canWithdraw == true));
    }

    function validEmployeeMovement(movementId) {
      let movement = request.resource.data;
      let itemPath = /databases/$(database)/documents/items/$(movement.itemId);
      let itemBefore = get(itemPath).data;
      let itemAfter = getAfter(itemPath).data;
      let employee = get(employeePath()).data;
      return isEmployee()
        && movement.keys().hasOnly([
          'itemId', 'itemNameSnapshot', 'itemCode', 'employeeId', 'employeeNameSnapshot',
          'matriculaSnapshot', 'movementType', 'quantity', 'quantityBefore', 'quantityAfter',
          'reason', 'createdAt', 'idempotencyKey'
        ])
        && employeeCanMove(movement.movementType)
        && movement.employeeId == employeeId()
        && movement.employeeNameSnapshot == employee.name
        && movement.matriculaSnapshot == employee.matricula
        && movement.itemId is string
        && itemBefore.active == true
        && movement.itemNameSnapshot == itemBefore.name
        && movement.itemCode == itemBefore.code
        && movement.quantity is number
        && movement.quantity > 0
        && movement.quantity <= 1000000000
        && movement.quantityBefore == itemBefore.quantity
        && movement.quantityAfter == itemAfter.quantity
        && movement.reason is string
        && movement.reason.size() <= 250
        && movement.createdAt == request.time
        && itemAfter.lastMovementId == movementId
        && ((movement.movementType == 'entry'
            && movement.quantityAfter == movement.quantityBefore + movement.quantity)
          || (movement.movementType == 'withdrawal'
            && movement.quantityBefore >= movement.quantity
            && movement.quantityAfter == movement.quantityBefore - movement.quantity));
    }

    function validEmployeeStockUpdate(itemId) {
      let movementId = request.resource.data.lastMovementId;
      let movementPath = /databases/$(database)/documents/stockMovements/$(movementId);
      let movement = getAfter(movementPath).data;
      let quantity = request.resource.data.quantity;
      return isEmployee()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quantity', 'stockStatus', 'updatedAt', 'lastMovementId'])
        && existsAfter(movementPath)
        && movement.itemId == itemId
        && movement.employeeId == employeeId()
        && movement.quantityBefore == resource.data.quantity
        && movement.quantityAfter == quantity
        && request.resource.data.lastMovementId != resource.data.lastMovementId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.stockStatus
          == (quantity <= 0 ? 'empty' : quantity <= resource.data.minimumStock ? 'low' : 'normal');
    }

    function validEmployeeInitialMovement(movementId, itemId, movement) {
      let itemPath = /databases/$(database)/documents/items/$(itemId);
      let item = getAfter(itemPath).data;
      let employee = get(employeePath()).data;
      return isEmployee()
        && movement.keys().hasOnly([
          'itemId', 'itemNameSnapshot', 'itemCode', 'employeeId', 'employeeNameSnapshot',
          'matriculaSnapshot', 'movementType', 'quantity', 'quantityBefore', 'quantityAfter',
          'reason', 'createdAt', 'idempotencyKey'
        ])
        && item.createdByUid == request.auth.uid
        && item.createdAt == request.time
        && item.lastMovementId == movementId
        && movement.itemId is string
        && movement.itemId == itemId
        && movement.itemNameSnapshot == item.name
        && movement.itemCode == item.code
        && movement.employeeId == employeeId()
        && movement.employeeNameSnapshot == employee.name
        && movement.matriculaSnapshot == employee.matricula
        && movement.movementType == 'entry'
        && movement.quantity is number
        && movement.quantity > 0
        && movement.quantity <= 1000000000
        && movement.quantityBefore == 0
        && movement.quantityAfter == item.quantity
        && movement.reason == 'Saldo inicial do cadastro'
        && movement.createdAt == request.time
        && movement.idempotencyKey == movementId;
    }

    function validEmployeeItemCreate(itemId) {
      let item = request.resource.data;
      let movementId = 'initial_' + itemId;
      let movementPath = /databases/$(database)/documents/stockMovements/$(movementId);
      return isEmployee()
        && item.keys().hasOnly([
          'name', 'code', 'description', 'category', 'itemType', 'trackingMode', 'unit',
          'quantity', 'minimumStock', 'stockStatus', 'rackNumber', 'shelfNumber',
          'locationNote', 'imageUrl', 'imageObjectKey', 'customFields', 'active',
          'searchTokens', 'updatedAt', 'createdAt', 'createdByUid', 'codeKey', 'lastMovementId'
        ])
        && item.keys().hasAll([
          'name', 'code', 'description', 'category', 'itemType', 'trackingMode', 'unit',
          'quantity', 'minimumStock', 'stockStatus', 'rackNumber', 'shelfNumber',
          'locationNote', 'imageUrl', 'imageObjectKey', 'customFields', 'active',
          'searchTokens', 'updatedAt', 'createdAt', 'createdByUid', 'codeKey'
        ])
        && item.createdByUid == request.auth.uid
        && item.name is string && item.name.size() > 0 && item.name.size() <= 120
        && item.code is string && item.code.size() > 0 && item.code.size() <= 64
        && item.description is string && item.description.size() <= 2000
        && item.category is string && item.category.size() <= 80
        && item.itemType in ['piece', 'component', 'tool', 'machine']
        && item.trackingMode == 'quantity'
        && item.unit is string && item.unit.size() > 0 && item.unit.size() <= 20
        && item.quantity is number && item.quantity >= 0 && item.quantity <= 1000000000
        && item.minimumStock == 0
        && item.stockStatus == (item.quantity <= 0 ? 'empty' : 'normal')
        && item.rackNumber is string && item.rackNumber.size() <= 20
        && item.shelfNumber is string && item.shelfNumber.size() <= 20
        && item.locationNote is string && item.locationNote.size() <= 100
        && item.imageUrl is string
        && item.imageObjectKey == ''
        && item.customFields is list && item.customFields.size() <= 30
        && item.searchTokens is list && item.searchTokens.size() <= 300
        && item.active == true
        && item.createdAt == request.time
        && item.updatedAt == request.time
        && item.codeKey is string
        && (item.quantity == 0
          ? !('lastMovementId' in item) && !existsAfter(movementPath)
          : item.lastMovementId == movementId
            && existsAfter(movementPath)
            && validEmployeeInitialMovement(movementId, itemId, getAfter(movementPath).data));
    }

    function validEmployeeItemCode(code) {
      let mapping = request.resource.data;
      let itemPath = /databases/$(database)/documents/items/$(mapping.itemId);
      let item = getAfter(itemPath).data;
      return isEmployee()
        && mapping.keys().hasOnly(['itemId'])
        && mapping.itemId is string
        && item.createdByUid == request.auth.uid
        && item.createdAt == request.time
        && item.codeKey == code
        && item.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /items/{itemId} {
      allow get: if isAdmin() || (isEmployee()
        && (!exists(/databases/$(database)/documents/items/$(itemId)) || resource.data.active == true));
      allow list: if isAdmin() || (isEmployee() && resource.data.active == true);
      allow create: if isAdmin() || validEmployeeItemCreate(itemId);
      allow delete: if isAdmin();
      allow update: if isAdmin() || validEmployeeStockUpdate(itemId);
    }

    match /employees/{employeeId} {
      allow read: if isAdmin()
        || (signedIn() && exists(employeeAuthPath()) && get(employeeAuthPath()).data.employeeId == employeeId);
      allow write: if isAdmin();
    }

    match /employeeAuth/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /employeeLookup/{matricula} {
      allow read, write: if isAdmin();
    }

    match /itemCodes/{code} {
      allow read: if isAdmin() || isEmployee();
      allow create: if isAdmin() || validEmployeeItemCode(code);
      allow update, delete: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read: if isAdmin() || (isEmployee() && (
        !exists(/databases/$(database)/documents/stockMovements/$(movementId))
        || resource.data.employeeId == employeeId()
      ));
      allow create: if isAdmin() || validEmployeeMovement(movementId)
        || validEmployeeInitialMovement(movementId, request.resource.data.itemId, request.resource.data);
      allow update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /machineAssets/{assetId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /authLimits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
